# Copia este archivo como .env y completa los valores.

# ── API de modelos ───────────────────────────────────────────────────────────
# Sin MODEL_API_URL el sitio responde en modo simulado (resultados inventados).
# MODEL_API_URL=http://127.0.0.1:8000
# MODEL_API_TIMEOUT_MS=30000

# Detector por defecto del sitio (id del catálogo; por defecto everest).
# GALENA_DEFAULT_DETECTOR=everest
