# Copia este archivo como .env y completa los valores (Supabase → Project Settings → API Keys).

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key: puede usarse en el navegador; respeta RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key: SOLO servidor, ignora RLS. Nunca en el navegador ni con prefijo VITE_.
SUPABASE_SECRET_KEY=sb_secret_...

# ── API de modelos ───────────────────────────────────────────────────────────
# Sin MODEL_API_URL el sitio responde en modo simulado.
# MODEL_API_URL=http://127.0.0.1:8000
